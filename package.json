{
  "name": "gestionstock",
  "productName": "GestionStock",
  "version": "1.0.0",
  "description": "Logiciel de Point de Vente et Gestion de Stock (Gros & Détail)",
  "author": "GestionStock",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build && electron-builder",
    "lint": "oxlint",
    "preview": "vite preview",
    "build:dir": "tsc && vite build && electron-builder --dir",
    "keygen": "node scripts/generate-license.js"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "autoprefixer": "^10.6.1",
    "concurrently": "^10.0.5",
    "cross-env": "^10.1.0",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "oxlint": "^1.81.0",
    "postcss": "^8.5.28",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vite-plugin-electron": "^1.1.2",
    "vite-plugin-electron-renderer": "^1.0.0"
  },
  "main": "dist-electron/main.js",
  "build": {
    "appId": "com.gestionstock.app",
    "productName": "GestionStock",
    "directories": {
      "output": "dist-app"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json",
      "!scripts/**/*"
    ],
    "asarUnpack": [
      "**/*.node"
    ],
    "extraFiles": [
      {
        "from": "build-resources/dlls",
        "to": ".",
        "filter": [
          "*.dll"
        ]
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "dir",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "GestionStock PRO",
      "artifactName": "${productName}-Setup-${version}.${ext}",
      "runAfterFinish": true
    },
    "npmRebuild": false
  }
}